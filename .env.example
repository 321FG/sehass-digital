# Sehass Digital — environment configuration
#
# Copy this file to `.env.local` for local development. In production,
# set the same variables in the hosting platform. Never commit real
# values. These are all server-side; do not add the NEXT_PUBLIC_ prefix.

# --- Contact form delivery -------------------------------------------
# The /contact form (src/app/contact/actions.ts) is honest about its
# state: without CONTACT_WEBHOOK_URL configured, submissions return
# `{ ok: false, code: "not-configured" }` and the UI directs users to
# email juliuss@sehassdigital.com directly. Do NOT fake a success path.
#
# CONTACT_WEBHOOK_URL should be an HTTPS endpoint that accepts a JSON
# POST — e.g. a Formspree endpoint, a Zapier catch hook, a Resend
# proxy, or a Sehass-owned API route on another service.
CONTACT_WEBHOOK_URL=

# Optional. If set, the server action sends
# `Authorization: Bearer $CONTACT_WEBHOOK_TOKEN` with each POST.
CONTACT_WEBHOOK_TOKEN=
